{
  "name": "film-tonight",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "npm run build && wrangler pages dev dist --ip 127.0.0.1 --port 8788 --persist-to .wrangler/state",
    "test": "node --test tests/*.test.js",
    "test:python": "python3 -m unittest discover -s tests -v"
  },
  "dependencies": {
    "leaflet": "1.9.4"
  },
  "overrides": {
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "vite": "8.3.5",
    "wrangler": "4.152.0"
  }
}
